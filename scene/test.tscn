[sub_resource type="GDScript" id="GDScript_khhxn"]
script/source = "@tool
extends MeshInstance3D

@export_tool_button(\"Create\", \"Callable\") var create = test
@export_tool_button(\"Final\", \"Callable\") var create2 = damn
var arr : Array  = []
var temp : Array[PackedInt32Array] = []


const SRC_QUADS := 64
const SRC_STRIDE := SRC_QUADS + 1   # 65 vertices per row in the source mesh


func build_lod(child_name: String, step: int) -> void:
	var child: MeshInstance3D = get_node(child_name)
	var meshArr: Array = get_mesh().surface_get_arrays(0)

	@warning_ignore(\"integer_division\")
	var w: int = SRC_QUADS / step + 1   # vertices per row/column in the LOD grid

	# source-mesh index of every sampled vertex, row by row
	var indices: Array = []
	for row in w:
		for col in w:
			indices.append(row * step * SRC_STRIDE + col * step)

	var packedIndices: PackedInt32Array = []
	for i in indices.size() - w:
		var a: int = indices[i]
		var b: int = indices[i + 1]
		var c: int = indices[i + w]
		var f: int = indices[i + w - 1]
		if i % w == 0:                 # first column: no left neighbour
			packedIndices.append_array([a, b, c])
		elif (i + 1) % w == 0:         # last column: no right neighbour
			packedIndices.append_array([a, c, f])
		else:
			packedIndices.append_array([a, b, c])
			packedIndices.append_array([a, c, f])

	var childMeshArr: Array = meshArr.duplicate_deep()
	childMeshArr[Mesh.ARRAY_INDEX] = packedIndices
	temp.append(packedIndices.duplicate())

	var newMesh := ArrayMesh.new()
	newMesh.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, childMeshArr)
	child.mesh = newMesh


func damn2(child_name: String) -> void:
	var child: MeshInstance3D = get_node(child_name)
	var meshArr: Array = get_mesh().surface_get_arrays(0)
	var newMesh := ArrayMesh.new()
	var lod  : Dictionary[float, PackedInt32Array] = {
		10.0 : temp[0],
		20.0 : temp[1],
		30.0 : temp[2],
	}
	print(temp.size())
	newMesh.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, meshArr,[],lod)
	child.mesh = newMesh
	

func damn() -> void :
	damn2(\"MeshInstance3D5\")

func test() -> void:      # 32 x 32 (your current version)
	build_lod(\"MeshInstance3D2\", 2)
	build_lod(\"MeshInstance3D3\", 4)
	build_lod(\"MeshInstance3D4\", 8)
	print(temp.size())
	print(temp)

func test_16() -> void:   # 16 x 16
	build_lod(\"MeshInstance3D3\", 4)

func test_8() -> void:    # 8 x 8
	build_lod(\"MeshInstance3D4\", 8)
"

