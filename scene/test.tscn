[sub_resource type="GDScript" id="GDScript_m2k3b"]
script/source = "@tool
extends Node3D

@export_tool_button(\"Create\", \"Callable\") var create = renderGrid
@export var size : int  
@export var ring : int  
@export var tile : ArrayMesh

func _ready() -> void:
	pass

func renderGrid() -> void :
	var parent : Node3D = get_node(\"Markers\")
	for i in parent.get_children() :
		i.queue_free()
	var dir : Array[Vector3] = [
		Vector3(1,0,0),
		Vector3(0,0,1),
		Vector3(-1,0,0),
		Vector3(0,0,-1),
	]
	var startDir : Array[Vector3] = [
		Vector3(-sqrt(2)/2,0,-sqrt(2)/2),
		Vector3(sqrt(2)/2,0,-sqrt(2)/2),
		Vector3(sqrt(2)/2,0,sqrt(2)/2),
		Vector3(-sqrt(2)/2,0,sqrt(2)/2),
	]
	for i in ring :
		var length : float = ((size * i) * sqrt(2)) + ((size * sqrt(2))/2)
		for j in 4 :
			var startPos : Vector3 = startDir[j] * length
			for k in ((i + 1) * 2) - 1 :
				#var meshNode : MeshInstance3D = MeshInstance3D.new()
				#parent.add_child(meshNode)
				#meshNode.owner = get_tree().edited_scene_root
				#
				#meshNode.set_position(startPos + (dir[j] * size * k))
				#meshNode.set_mesh(tile)
				#meshNode.set_lod_bias(0.001)
				
				var markerNode : Marker3D = Marker3D.new()
				parent.add_child(markerNode)
				markerNode.owner = get_tree().edited_scene_root
				
				markerNode.set_position(startPos + (dir[j] * size * k))
				markerNode.set_gizmo_extents(20)
				
"

